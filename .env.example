# Upstream gghstats (API-only or full serve). Server-only — never commit .env.
GGHSTATS_API_BASE=https://gghstats.hermesrodriguez.com
GGHSTATS_API_TOKEN=replace-me

# Example local api-only backend:
#   export GGHSTATS_API_ONLY=true
#   export GGHSTATS_API_TOKEN=dev-token
#   export GGHSTATS_CORS_ORIGINS=http://localhost:5173
#   gghstats serve
# Then:
# GGHSTATS_API_BASE=http://127.0.0.1:8080
# GGHSTATS_API_TOKEN=dev-token
